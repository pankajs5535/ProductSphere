{
  "ConnectionStrings": {
    "DefaultConnection": "Server=Skylark;Database=Product_SphereDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  // JWT_Auth - Start

  "JwtSettings": {
    "Issuer": "ProductSphereAPI",
    "Audience": "ProductSphereClient",
    "SecretKey": "ThisIsASuperSecretKeyForJwtAuthentication12345",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  // JWT_Auth - End

  // Serilog - Start
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  // Serilog - End

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}